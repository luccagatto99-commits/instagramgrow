import * as THREE from 'three';
import { B, T, lerp, suave, clamp } from './tempo';

type V = [number, number, number];
type Chave = { t: number; pos: V; alvo: V; fov?: number; d?: number; deriva?: V };

const chaves = (): Chave[] => [
  // gancho: a máquina entra girando e centrifugando, de frente
  { t: 0, pos: [0.9, 2.0, 8.6], alvo: [0, 1.4, 0], deriva: [0.0, 0, -0.15] },
  // vista explodida: de lado e de cima, para ver o tanque e o tambor saindo pela frente
  { t: T(1, 'tanque') - 0.2, pos: [6.8, 3.8, 7.8], alvo: [0, 1.5, 1.3], d: 1.6, deriva: [-0.05, 0, -0.06] },
  // água: válvula atrás, gaveta na frente, tubinho do lado
  { t: B(2) + 0.4, pos: [-3.6, 4.6, 5.4], alvo: [0, 1.9, 0], d: 1.5, deriva: [0.03, 0, -0.05] },
  { t: T(2, 'tubinho') - 0.2, pos: [5.6, 3.2, 6.0], alvo: [0.3, 1.4, 0.1], d: 1.3, deriva: [-0.03, 0, -0.04] },
  // motor e correia, por trás
  { t: B(3) + 0.3, pos: [3.2, 1.3, -5.8], alvo: [0.15, 1.0, -0.9], d: 1.6, deriva: [-0.04, 0, 0.04] },
  { t: T(3, 'pás') - 0.2, pos: [6.2, 2.1, 0.6], alvo: [0, 1.35, 0], d: 0.8 },
  // pás e roupa, de frente pela porta
  { t: T(3, 'roupa') - 0.1, pos: [0.7, 1.75, 4.4], alvo: [0, 1.35, 0], d: 0.8, deriva: [0, 0, -0.04] },
  // bomba
  { t: B(4) + 0.3, pos: [3.4, 1.5, 4.8], alvo: [0.35, 0.7, 0.3], d: 1.4, deriva: [-0.03, 0, -0.04] },
  // centrifugação, de frente
  { t: T(4, 'gira') - 0.3, pos: [0.9, 1.8, 4.6], alvo: [0, 1.35, 0], d: 1.3, deriva: [0, 0, -0.04] },
  // concreto: a máquina inteira, para ver ela andar
  { t: B(5) + 0.2, pos: [5.0, 3.4, 7.6], alvo: [0.2, 1.5, 0], d: 1.6, deriva: [-0.04, 0, -0.06] },
  { t: T(5, 'bloco') - 0.3, pos: [3.6, 3.8, 5.2], alvo: [0.3, 1.9, 0.2], d: 1.3, deriva: [-0.03, 0, -0.04] },
  // fechamento
  { t: B(6) + 0.2, pos: [0.6, 2.0, 9.4], alvo: [0, 1.4, 0], d: 1.6, deriva: [0, 0, -0.1] },
];

let cache: Chave[] | null = null;
const em = (k: Chave, t: number, limite: number) => {
  const dt = Math.max(0, Math.min(t, limite) - k.t);
  const dv = k.deriva ?? [0, 0, 0];
  return { pos: [k.pos[0] + dv[0] * dt, k.pos[1] + dv[1] * dt, k.pos[2] + dv[2] * dt] as V, alvo: k.alvo, fov: k.fov ?? 36 };
};

export type Cam = { pos: V; alvo: V; fov: number };

export const camera = (t: number): Cam => {
  const ks = (cache ??= chaves());
  let i = 0;
  while (i + 1 < ks.length && ks[i + 1].t - (ks[i + 1].d ?? 1.2) <= t) i++;
  const k = ks[i];
  if (t >= k.t || i === 0) return em(k, t, Infinity);
  const ant = ks[i - 1];
  const d = k.d ?? 1.2;
  const u = suave(clamp((t - (k.t - d)) / d));
  const a = em(ant, t, k.t - d);
  const b = em(k, k.t, k.t);
  const mix = (p: V, q: V): V => [lerp(p[0], q[0], u), lerp(p[1], q[1], u), lerp(p[2], q[2], u)];
  return { pos: mix(a.pos, b.pos), alvo: mix(a.alvo, b.alvo), fov: lerp(a.fov, b.fov, u) };
};

const camProj = new THREE.PerspectiveCamera(36, 1080 / 1920, 0.05, 100);
const v = new THREE.Vector3();
export const projetar = (c: Cam, p: V) => {
  camProj.fov = c.fov;
  camProj.updateProjectionMatrix();
  camProj.position.set(...c.pos);
  camProj.lookAt(...c.alvo);
  camProj.updateMatrixWorld();
  v.set(...p).project(camProj);
  return { x: ((v.x + 1) / 2) * 1080, y: ((1 - v.y) / 2) * 1920, frente: v.z < 1 };
};
