// Linha do tempo do airbag: tudo que acontece na cena sai daqui, em função do tempo (s).
// Coordenadas: volante de frente para +z, centro em C; a central (ECU) fica embaixo; câmera dos cortes em +x.
import { B, BE, T, clamp, janela, lerp, prog, saida, suave, entrada } from './tempo';

export const COR = {
  fundo: '#0E1A2B',
  objeto: '#F4F1EA',
  move: '#FF6B2C', // só o que se move: corrente, fogo, gás
  rotulo: '#8FB8FF',
  sombra: '#B5AE9C',
  traco: '#0E1A2B',
  escuro: '#2A3446',
  tecido: '#ECE6D8',
};

export type V2 = [number, number];
export type V3 = [number, number, number];

// ---- medidas ----
export const C: V3 = [0, 2.2, 0]; // centro do volante
export const ARO = 1.45;
export const CUBO = { r: 0.72, z0: -0.26, z1: 0.26 }; // miolo do volante
export const GERADOR = { r: 0.42, h: 0.2, z: -0.13 };
export const ECU: V3 = [0, 0.18, 0.55]; // central eletrônica
export const ECU_TAM: V3 = [1.1, 0.34, 0.8];
export const SACO = { rx: 1.25, ry: 1.12, rz: 0.62 }; // bolsa cheia (semieixos)

// ---- eventos ----
const ev = () => ({
  // gancho: entra girando, explode, rebobina
  explode: T(0, 'explosão') - 0.05,
  rebobina: T(0, 'Em') + 0.05,
  // cortes
  corte: T(1, 'escondido') - 0.1,
  // sensor
  buraco: T(2, 'buraco') - 0.05,
  batida: T(2, 'batida') - 0.1,
  dispara: T(2, 'disparar') - 0.05,
  // corrente
  corrente: T(3, 'corrente') - 0.15,
  chega: T(3, 'iniciador') + 0.1,
  esquenta: T(3, 'esquenta') - 0.05,
  fogo: T(3, 'fogo') - 0.05,
  // pastilhas
  acende: T(4, 'acende') - 0.05,
  queimam: T(4, 'queimam') - 0.05,
  gas: T(4, 'gás') - 0.3,
  // filtro e enchimento
  filtro: T(5, 'filtro') - 0.2,
  rasga: T(5, 'rasga') - 0.05,
  enche: T(5, 'enche') - 0.15,
  // furos e cabeça
  furos: T(6, 'furos') - 0.15,
  cabeca: T(6, 'cabeça') - 0.55,
  encosta: T(6, 'encosta') + 0.05,
  murcha: T(6, 'murcha') - 0.1,
  // pó
  po: T(7, 'pó') - 0.35,
  fim: B(8),
});
let EV: ReturnType<typeof ev> | null = null;
export const E = () => (EV ??= ev());

export type Estado = ReturnType<typeof estado>;

/** tranco do carro (0..1) visto pelo sensor: um pico curto no buraco e um enorme e longo na batida */
export const tranco = (t: number) => {
  const e = E();
  const b = Math.exp(-Math.pow((t - (e.buraco + 0.35)) / 0.12, 2)) * 0.28;
  const u = t - (e.batida + 0.25);
  const bat = u < 0 ? Math.exp(-Math.pow(u / 0.1, 2)) : Math.exp(-Math.pow(u / 0.9, 2));
  return Math.max(b, bat * (t < e.fim ? 1 : 0));
};

export const estado = (t: number) => {
  const e = E();

  // --- gancho: entra pela direita dando uma volta inteira ---
  const entrada0 = prog(t, 0, 1.7, saida);
  const giro = (1 - entrada0) * Math.PI * 2;
  const xEntrada = (1 - entrada0) * 6;
  // explosão rápida do gancho e rebobinada
  const ganchoCheio = t < e.rebobina ? prog(t, e.explode, 0.18, saida) : 1 - prog(t, e.rebobina, 1.1, suave);

  // --- corte: a metade de cá do miolo e a tampa viram contorno ---
  const corte = prog(t, e.corte, 0.8) * (1 - prog(t, e.rasga - 0.6, 0.5));
  const corteGerador = prog(t, e.corrente + 1.6, 0.8) * (1 - prog(t, e.rasga - 0.6, 0.5));

  // --- solavancos ---
  const shake = (t0: number, amp: number, d: number) => {
    const u = t - t0;
    if (u < 0 || u > d) return 0;
    return amp * Math.sin(u * 55) * (1 - u / d);
  };
  const tremor = shake(e.buraco + 0.3, 0.025, 0.5) + shake(e.batida + 0.2, 0.09, 1.0);

  // --- corrente elétrica: do sensor ao iniciador ---
  const corrente = janela(t, e.corrente, e.fogo + 0.3, 0.2, 0.3);
  const iniciador = Math.max(prog(t, e.esquenta, 0.5), 0) * (1 - prog(t, e.gas, 1.0));
  const faisca = janela(t, e.fogo, e.fogo + 1.0, 0.05, 0.6);

  // --- pastilhas: acendem em onda e queimam ---
  const pastilhaAcesa = (i: number, n: number) => prog(t, e.acende + (i / n) * 0.9, 0.3);
  const pastilhaTam = 1 - prog(t, e.queimam, 1.6, suave);
  const gasCamara = prog(t, e.queimam + 0.2, 1.2) * (1 - prog(t, e.rasga + 0.4, 0.8));
  const gasFiltro = prog(t, e.filtro, 0.6) * (1 - prog(t, e.rasga + 0.4, 0.8));

  // --- bolsa: rasga a tampa e enche (câmera lenta), murcha depois que a cabeça encosta ---
  const abreTampa = Math.max(t < e.rebobina + 1.2 ? ganchoCheio : 0, prog(t, e.rasga, 0.5, saida));
  const encheReal = prog(t, e.enche - 0.4, 1.3, saida);
  const murcha = prog(t, e.encosta + 0.6, 2.6, suave);
  const cheio = Math.max(ganchoCheio, encheReal * (1 - 0.6 * murcha));
  const enchendo = janela(t, e.enche - 0.4, e.enche + 1.0, 0.1, 0.4);
  const vazando = janela(t, e.encosta + 0.5, e.encosta + 3.4, 0.2, 0.6);
  const furos = janela(t, e.furos, e.po, 0.3, 0.4);

  // --- cabeça do boneco ---
  const zCabeca0 = 4.2;
  const zEncosta = C[2] + 0.3 + 0.55 + SACO.rz + 0.24; // frente da bolsa cheia + raio da cabeça
  let zCabeca = zCabeca0;
  if (t >= e.cabeca) zCabeca = lerp(zCabeca0, zEncosta, prog(t, e.cabeca, e.encosta - e.cabeca, entrada));
  if (t >= e.encosta) zCabeca = zEncosta - 0.62 * prog(t, e.encosta, 3.0, saida);
  const cabeca = janela(t, e.cabeca - 0.6, e.po + 0.3, 0.4, 0.6);
  if (t > e.po - 0.4) zCabeca += 1.6 * prog(t, e.po - 0.4, 1.0, entrada);

  // --- pó branco ---
  const po = prog(t, e.po, 4.5);
  const poV = janela(t, e.po, e.fim + 0.6, 0.3, 1.0);

  // --- fechamento: a bolsa volta a ficar guardada e o volante gira devagar ---
  const fecha = prog(t, e.fim - 0.4, 1.2);
  const cheioFinal = cheio * (1 - fecha);
  const giroFinal = t > e.fim ? 0.35 * Math.sin((t - e.fim) * 0.6) : 0;

  return {
    t, giro: giro + giroFinal, xEntrada, tremor, corte, corteGerador,
    corrente, iniciador, faisca, pastilhaAcesa, pastilhaTam, gasCamara, gasFiltro,
    abreTampa: abreTampa * (1 - fecha), cheio: cheioFinal, enchendo, vazando, furos,
    zCabeca, cabeca, po, poV, tranco: tranco(t), dobrada: cheioFinal < 0.04,
  };
};

export { clamp, lerp, BE };
